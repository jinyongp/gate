{
  "name": "@gate/node",
  "version": "0.0.0",
  "type": "module",
  "description": "Agent-friendly Node API for gate",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gate": "./bin/gate.mjs"
  },
  "files": [
    "bin/gate.mjs",
    "dist/index.d.mts",
    "dist/index.mjs"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "test:build": "tsdown 'src/**/*.test.ts' --format esm --no-clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/**/*.test.mjs"
  },
  "optionalDependencies": {
    "@gate/binary-darwin-arm64": "workspace:*",
    "@gate/binary-darwin-x64": "workspace:*",
    "@gate/binary-linux-arm64": "workspace:*",
    "@gate/binary-linux-x64": "workspace:*"
  }
}
