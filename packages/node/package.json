{
  "name": "@gate/node",
  "version": "0.0.0",
  "description": "Agent-friendly Node API and CLI launcher for gate",
  "keywords": [
    "agent",
    "cli",
    "dev-server",
    "https",
    "local-dev",
    "port-registry",
    "reverse-proxy"
  ],
  "homepage": "https://github.com/jinyongp/gate#readme",
  "bugs": {
    "url": "https://github.com/jinyongp/gate/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinyongp/gate.git",
    "directory": "packages/node"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gate": "bin/gate.mjs"
  },
  "files": [
    "bin/gate.mjs",
    "dist/index.d.mts",
    "dist/index.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "test:build": "tsdown 'src/**/*.test.ts' --format esm --no-clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/**/*.test.mjs"
  },
  "optionalDependencies": {
    "@gate/binary-darwin-arm64": "workspace:*",
    "@gate/binary-darwin-x64": "workspace:*",
    "@gate/binary-linux-arm64": "workspace:*",
    "@gate/binary-linux-x64": "workspace:*"
  }
}
