{
  "name": "@gate/repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "node:build": "pnpm --filter @gate/node build",
    "node:pack:dry-run": "pnpm node:pack:dry-run:js",
    "node:pack:dry-run:js": "pnpm node:build && pnpm --filter @gate/node pack --dry-run",
    "node:smoke:examples": "node scripts/node/smoke-examples.mjs",
    "node:stage:binaries": "node scripts/node/stage-binary-packages.mjs",
    "node:typecheck": "pnpm node:build && pnpm --filter @gate/node typecheck",
    "node:test": "pnpm node:build && pnpm --filter @gate/node test:build && node --test packages/node/dist/**/*.test.mjs",
    "node:check": "pnpm node:typecheck && pnpm node:test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
