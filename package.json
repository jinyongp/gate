{
  "name": "@jinyongp/gate-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "node:build": "pnpm --filter @jinyongp/gate build",
    "node:check": "pnpm node:format:check && pnpm node:lint && pnpm node:typecheck && pnpm node:test && pnpm node:publish:test",
    "node:format": "oxfmt --write packages/node/bin packages/node/src scripts/node examples/node",
    "node:format:check": "oxfmt --check packages/node/bin packages/node/src scripts/node examples/node",
    "node:lint": "oxlint packages/node/bin packages/node/src scripts/node examples/node --deny-warnings",
    "node:pack:dry-run": "pnpm node:pack:dry-run:js",
    "node:pack:dry-run:js": "pnpm node:build && pnpm --filter @jinyongp/gate pack --dry-run",
    "node:publish:test": "node --test scripts/node/publish-packages.test.mjs",
    "node:smoke:examples": "node scripts/node/smoke-examples.mjs",
    "node:stage:binaries": "node scripts/node/stage-binary-packages.mjs",
    "node:typecheck": "pnpm node:build && pnpm --filter @jinyongp/gate typecheck",
    "node:test": "pnpm --filter @jinyongp/gate test"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
